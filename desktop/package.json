{
  "name": "escudo-digital-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Shell de escritorio (Electron) para Escudo Digital — Windows, macOS y Linux.",
  "main": "main.js",
  "homepage": "https://github.com/chavesgabriel012-svg/AIassistant",
  "author": {
    "name": "Escudo Digital",
    "email": "soporte@escudodigital.cr"
  },
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development ESCUDO_APP_URL=http://localhost:3000 electron .",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
