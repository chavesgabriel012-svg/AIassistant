# ==========================================================================
# Escudo Digital — Variables de entorno (plantilla)
# Copia este archivo a .env.local y rellena los valores reales.
# NUNCA commitees .env.local. Los secretos viven en Vercel (Environment Vars).
# ==========================================================================

# --- Supabase ---------------------------------------------------------------
# Público (expuesto al browser): protegido por RLS.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="ey...anon"

# Privado (SOLO server / edge): salta RLS. Jamás exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY="ey...service_role"

# --- Proveedores de IA (LLM Routing) ---------------------------------------
ANTHROPIC_API_KEY="sk-ant-..."
OPENAI_API_KEY="sk-..."

# Overrides opcionales de modelos (ver src/lib/ai/router.ts para defaults).
# TRIAGE_MODEL="claude-haiku-4-5"
# DRAFT_MODEL="claude-haiku-4-5"
# ESCALATION_MODEL="claude-sonnet-5"

# --- Canales ----------------------------------------------------------------
# WhatsApp Cloud API (Meta): token de verificación del webhook.
WHATSAPP_VERIFY_TOKEN="define-un-token-de-verificacion"
# Gmail (OAuth + Pub/Sub push). Redirect URI:
#   {NEXT_PUBLIC_APP_URL}/api/oauth/gmail/callback
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# Topic de Pub/Sub para las notificaciones de Gmail (users.watch).
# Formato: projects/TU-PROYECTO/topics/gmail-push
GOOGLE_PUBSUB_TOPIC=""

# Outlook (pendiente de connect flow):
# MICROSOFT_OAUTH_CLIENT_ID=""
# MICROSOFT_OAUTH_CLIENT_SECRET=""

# --- Seguridad de Webhooks --------------------------------------------------
# Secreto compartido para verificar la firma HMAC de los webhooks entrantes.
WEBHOOK_SIGNING_SECRET="genera-un-secreto-largo-y-aleatorio"

# --- Cifrado de tokens OAuth de usuarios (correo/WhatsApp) ------------------
# Clave AES-256-GCM de 32 bytes en base64. Genera con:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="base64-de-32-bytes"

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
